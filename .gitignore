# ============================================================
# Python
# ============================================================
# Виртуальное окружение
.venv/
venv/
env/

# Локальные настройки Claude Code (не для git)
.claude/

# Кэши и байткод
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
*.whl
.python-version

# Инструменты
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# ============================================================
# Секреты и настройки БОТА — их нельзя коммитить
# ============================================================
# Реальный конфиг с секретами (API_ID, API_HASH, PHONE, MT_PROXY, ALLOWED_USERS)
config.env

# Файл авторизации MTProto-клиента (сессия входа в Telegram) — секрет
# и связанные SQLite-файлы (WAL-журнал, SHM) — пересоздаются при работе, мусор для git
*.session
*.session-journal
*.session-wal
*.session-shm
claude-tg-bot.session

# Состояние сессий пользователей (каталоги и контекст)
state.json

# ============================================================
# Логи
# ============================================================
*.log
logs/
# NB: НЕ используем *.txt — иначе исключится requirements.txt

# ============================================================
# ОС / редакторы
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Файлы-артефакты macOS (сжатые копии при копировании)
*.cpgz
*._*

# Редакторы
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# Временные файлы
# ============================================================
tmp/
temp/
*.tmp
*.bak

