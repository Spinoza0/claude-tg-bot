# ============================================================
# Telegram (MTProto) — get it at https://my.telegram.org/apps
# NOTE: this is an EXAMPLE. Put YOUR real codes into a copy of config.env.
# ============================================================
API_ID=111111
API_HASH=00000000000000000000000000000000
PHONE=+70000000000

# MTProto proxy in the format tg://proxy?server=...&port=...&secret=...
# OPTIONAL: if left empty — the bot connects to Telegram directly, without a
# proxy. A proxy is needed only if direct access is unavailable.
# This is a FAKE example. Put your real tg://proxy into config.env.
MT_PROXY=tg://proxy?server=example.example.com&port=443&secret=0000000000000000000000000000000000000000

# Telegram 2FA password (if enabled), else empty
CLOUD_TOKEN_PASSWORD=

# Session file name (a .session file will be created)
SESSION_NAME=claude-tg-bot

# Bot message language (Telegram + console): en or ru. One language = one file
# in claude_tg_bot/locale/. Empty/unknown -> en. Can be switched on the fly with /lang.
BOT_LANG=

# ============================================================
# Bot access
# ============================================================
# Telegram user_id allowed to reach the bot (comma-separated, optionally quoted).
# Find your id: message @userinfobot.
ALLOWED_USERS="111222333"

# The concrete chat_id where the bot answers (comma-separated, optionally quoted).
# The bot works under an account, so it answers NOT everywhere it's mentioned,
# but ONLY in these chats. How to find the chat id — see README.
# Example: ALLOWED_CHAT_IDS="-1001234567890,-1009876543210"
# EMPTY ("" — or no line) = the bot answers only in Saved Messages, not in groups.
# How to find the chat id — see README.
ALLOWED_CHAT_IDS=""

# ============================================================
# Claude
# ============================================================
# The command that launches Claude. Default — plain "claude".
# You can specify another wrapper (your own or third-party).
CLAUDE_COMMAND=claude

# Additional command-line arguments appended to CLAUDE_COMMAND.
# Specified as one string and split into individual arguments. Allows passing
# the wrapper its specific parameters. For plain "claude" usually not needed and
# left empty.
# Example for a Cline wrapper: COMMAND_ARGS=--provider openai-compatible
COMMAND_ARGS=

# Alternative argument set for a model switch when the main model is unavailable
# (API Error / Cannot connect / 502/503). Substituted INSTEAD OF COMMAND_ARGS on
# retry. Usually points at another provider/model. If empty — the bot retries
# with the base arguments without changing the model.
#COMMAND_ARGS_ALTERNATIVE=--provider openai-compatible --model <other>

# Permission mode (--permission-mode) for launching Claude. The bot runs without
# a terminal, so for autonomous work bypassPermissions is needed (otherwise
# Claude asks "What do you allow?" and hangs). Valid values:
#   bypassPermissions — full auto | acceptEdits — auto for file edits
#   plan — plan only | default — standard (may hang).
# WARNING: bypassPermissions is a trusted agent that may perform destructive
# actions without confirmation. For caution set acceptEdits.
CLAUDE_PERMISSION_MODE=bypassPermissions

# System prompt for Claude (--append-system-prompt): passed to the model as a
# system instruction. If left empty — the flag isn't added, Claude works with
# its standard system prompt.
CLAUDE_SYSTEM_PROMPT=

# Attachment-marker prompt (--append-system-prompt, added right after
# CLAUDE_SYSTEM_PROMPT). Tells Claude to save result files (image/video/audio/
# document) into the working dir's .claude_tg_bot_media folder and mark them with
# a "[FILE: path]" line so the bot can send them back as attachments. Empty —
# the built-in default instruction is used (attachments left on). Set a custom
# text to override it.
ATTACHMENT_SYSTEM_PROMPT=

# The directory (sandbox) where Claude runs for SANDBOX_COMMAND messages
# ("sandbox in any chat"). If NOT set — the sandbox
# ~/.claude-tg-bot/sandbox in the home directory is created and used.
# Example: SANDBOX_ROOT=/home/username/claude-sandbox
SANDBOX_ROOT=

# The trigger string for running the sandbox "in any chat": a message must start
# with this string, then a space + command/text. If not set/empty — the default
# "@helpbot" (the bot mention) is used. The value is shown in /help.
# Example: SANDBOX_COMMAND=@helpbot
SANDBOX_COMMAND=@helpbot

# The root inside which projects live (the bot can't be taken beyond these limits).
# MANDATORY parameter.
PROJECTS_ROOT=/home/username/projects

# Timeout for one Claude call, sec
CLAUDE_TIMEOUT_SECONDS=600

# Maximum prompt length (protection against huge messages)
MAX_PROMPT_LENGTH=8000

# The shared retry scheme on failures (Telegram connection, send, Claude).
# The pause after the n-th failure grows as base * multiplier^(n-1) up to the max cap.
RETRY_LIMIT=5            # total attempts (including the first) before giving up
RETRY_BASE_DELAY=60      # sec; starting pause (1 min)
RETRY_MAX_DELAY=300      # sec; cap (5 min), doesn't grow further
RETRY_MULTIPLIER=2.0     # pause growth multiplier

# Short retries for sending messages/indicators to Telegram (seconds) —
# these are transient inter-DC errors, not a network loss.
MESSAGE_RETRY_LIMIT=3
MESSAGE_RETRY_DELAY=2.0

# Auto-delete the attachment after sending to claude: true — delete (per DELETE_MODE),
# false — don't delete (manual cleanup via /clearmedia).
AUTO_DELETE_MEDIA=false

# Where to delete attachments: trash — macOS Trash (default), permanent — forever.
DELETE_MODE=trash

# Don't let the laptop sleep while the bot runs:
# true — keep the system awake (otherwise sleep drops the network and the bot
# stops receiving/answering messages). false — change nothing.
KEEP_AWAKE=false
# The command run to keep the system awake when KEEP_AWAKE is true (command +
# args, space-separated). Empty or not on PATH — the bot runs without it.
KEEP_AWAKE_COMMAND=caffeinate -dimsu