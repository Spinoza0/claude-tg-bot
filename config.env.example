# ============================================================
# Telegram (MTProto) — получить на https://my.telegram.org/apps
# ВНИМАНИЕ: это ПРИМЕР. Подставь СВОИ реальные код в копии config.env.
# ============================================================
API_ID=111111
API_HASH=00000000000000000000000000000000
PHONE=+70000000000

# MTProto-прокси в формате tg://proxy?server=...&port=...&secret=...
# ОПЦИОНАЛЬНО: если оставить пустым — бот подключается к Telegram напрямую,
# без прокси. Прокси нужен, только если прямой доступ недоступен.
# Это ФЕЙКОВЫЙ пример. Впиши свой реальный tg://proxy в config.env.
MT_PROXY=tg://proxy?server=example.example.com&port=443&secret=0000000000000000000000000000000000000000

# Пароль от двухфакторки Telegram (если включена), иначе пусто
CLOUD_TOKEN_PASSWORD=

# Имя файла сессии (будет создан .session)
SESSION_NAME=claude-tg-bot

# ============================================================
# Доступ к боту
# ============================================================
# Telegram user_id, с которых боту разрешено отвечать (через запятую, можно в кавычках).
# Узнать свой id: напиши @userinfobot.
ALLOWED_USERS="111222333"

# Конкретные chat_id, в КОТОРЫХ бот отвечает (через запятую, можно в кавычках).
# Бот работает под учёткой, поэтому отвечает НЕ везде, где написано,
# а ТОЛЬКО в этих чатах. Как узнать id чата — см. README.
# Пример: ALLOWED_CHAT_IDS="-1001234567890,-1009876543210"
# ПУСТО ("" — или нет строки) = бот отвечает только в «Избранном» (Saved
# Messages), а не в группах. Как узнать id чата — см. README.
ALLOWED_CHAT_IDS=""

# ============================================================
# Claude
# ============================================================
# Команда для запуска Claude. По умолчанию — обычный "claude".
# Можно указать другую обёртку (собственную или стороннюю).
CLAUDE_COMMAND=claude

# Дополнительные аргументы командной строки, добавляемые к CLAUDE_COMMAND.
# Задаются одной строкой и разбиваются на отдельные аргументы. Позволяет
# передать обёртке её специфичные параметры. Для обычного "claude" обычно
# не требуется и оставляется пустым.
# Пример для Cline-обёртки: COMMAND_ARGS=--provider openai-compatible
COMMAND_ARGS=

# Режим разрешений (--permission-mode) для запуска Claude. Бот работает без
# терминала, поэтому для автономной работы нужен bypassPermissions (иначе Claude
# спросит «Что разрешаешь?» и зависнет). Валидные значения:
#   bypassPermissions — полный авто | acceptEdits — авто для правок файлов
#   plan — только план | default — стандартный (может зависнуть).
# ВНИМАНИЕ: bypassPermissions — доверенный агент, может выполнять разрушительные
# действия без подтверждения. Для осторожности поставь acceptEdits.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Каталог (песочница), где Claude запускается для сообщений
# SANDBOX_COMMAND («агент в любом чате»). Если НЕ задан — создаётся и
# используется песочница ~/.claude-tg-bot/sandbox в домашней директории.
# Пример: SANDBOX_ROOT=/home/username/claude-agent-sandbox
SANDBOX_ROOT=

# Строка-триггер запуска агента «в любом чате»: сообщение обязано начинаться
# с этой строки, дальше пробел + команда/текст. Если не задана/пустая —
# используется дефолт "@helpbot" (упоминание бота). Значение показывается в /help.
# Пример: SANDBOX_COMMAND=@helpbot
SANDBOX_COMMAND=@helpbot

# Корень, внутри которого живут проекты (бота нельзя увести за эти пределы)
PROJECTS_ROOT=/home/username/projects

# Время ожидания одного вызова Claude, сек
CLAUDE_TIMEOUT_SECONDS=600

# Максимальная длина промпта (защита от гигантских сообщений)
MAX_PROMPT_LENGTH=8000

# Автоудаление вложения после отправки в claude: true — удалять (по DELETE_MODE),
# false — не удалять (очистка вручную командой /clearmedia).
AUTO_DELETE_MEDIA=false

# Куда удалять вложения: trash — в корзину macOS (по умолчанию), permanent — навсегда.
DELETE_MODE=trash